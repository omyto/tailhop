[Unit]
Description=Tailhop Tailnet forward proxy
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=tailhop
Group=tailhop
ExecStart=/usr/local/bin/tailhop --state-dir=/var/lib/tailhop
EnvironmentFile=-/etc/tailhop/tailhop.env
StateDirectory=tailhop
StateDirectoryMode=0700
Restart=on-failure
RestartSec=5s
TimeoutStopSec=20s
NoNewPrivileges=true
UMask=0077
ProtectSystem=strict
ProtectHome=true
# Keep temporary files writable without exposing the host's temporary files.
PrivateTmp=true

[Install]
WantedBy=multi-user.target
