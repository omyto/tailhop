# Prebuilt deployment: select a published tag from https://hub.docker.com/r/omyto/tailhop/tags
# Required by compose.release.yaml; no default or latest tag is assumed.
TAILHOP_VERSION=

# Initial enrollment only; remove after successful enrollment.
TS_AUTHKEY=replace-with-your-tailscale-auth-key
TS_HOSTNAME=tailhop
PROXY_PORT=8080
LOG_LEVEL=info
# Global inbound TCP connection limit (not per client IP).
MAX_CLIENTS=100
# Inactivity timeout for HTTP keep-alive, forwarding, and CONNECT.
IDLE_TIMEOUT=10m
