# Optional systemd EnvironmentFile: KEY=value, without export or shell expansion.
# Keep /etc/tailhop/tailhop.env owned by root:root with mode 0600.
# Interactive login needs no file. For automated initial enrollment, optionally
# uncomment TS_AUTHKEY and replace its placeholder with a Tailnet Auth Key.
# Remove TS_AUTHKEY after enrollment; valid persisted state reuses the identity.
# TS_AUTHKEY=replace-with-your-tailscale-auth-key
# Optional overrides (built-in defaults shown):
# TS_HOSTNAME=tailhop
# PROXY_PORT=8080
# MAX_CLIENTS=100
# IDLE_TIMEOUT=10m
# LOG_LEVEL=info
# The unit fixes --state-dir=/var/lib/tailhop; TS_STATE_DIR cannot override it.
