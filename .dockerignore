# Only send files used by the source build. Add new packages/assets explicitly.
# Re-exclude directory contents before allowing Go files: allowing a directory
# alone also allows its children under Docker's ignore rules.
**
!Dockerfile
!go.mod
!go.sum
!cmd
cmd/**
!cmd/tailhop
cmd/tailhop/**
!cmd/tailhop/*.go
!internal
internal/**
!internal/proxy
internal/proxy/**
!internal/proxy/*.go

# Required licensing materials copied into the final runtime image.
!LICENSE
!THIRD_PARTY_NOTICES
