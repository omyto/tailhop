# systemd EnvironmentFile syntax: KEY=value, without export or shell expansion.
# Keep /etc/tailhop/tailhop.env owned by root:root with mode 0600.
# Initial enrollment: replace the placeholder with an appropriate Tailnet key.
# Remove TS_AUTHKEY after successful enrollment; persisted state reuses identity.
TS_AUTHKEY=replace-with-your-tailscale-auth-key
TS_HOSTNAME=tailhop
PROXY_PORT=8080
# Global concurrent inbound TCP connections, not per client IP.
MAX_CLIENTS=100
# Positive Go duration; HTTP and CONNECT activity-based inactivity timeout.
IDLE_TIMEOUT=10m
LOG_LEVEL=info
# TS_STATE_DIR is set by the unit. Do not override it here: this installation
# requires /var/lib/tailhop, owned and protected through StateDirectory=tailhop.
